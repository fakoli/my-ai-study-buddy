# Study Buddy - Docker Environment Variables
# Copy to .env.docker and configure for your environment

# =============================================================================
# Application Settings
# =============================================================================

# Enable debug mode (true for development, false for production)
DEBUG=true

# =============================================================================
# Storage Configuration
# =============================================================================

# Storage backend: json (development), sqlite (production), supabase (cloud)
STORAGE_BACKEND=json

# Path for JSON/SQLite storage (inside container)
STORAGE_PATH=/app/data

# Supabase configuration (when STORAGE_BACKEND=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key

# =============================================================================
# Authentication
# =============================================================================

# JWT secret key (REQUIRED - generate a secure random string)
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string

# JWT token expiration in hours
JWT_EXPIRATION_HOURS=24

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed origins for CORS (comma-separated)
# Development: http://localhost:3000,http://localhost:5173
# Production: https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# AI Services
# =============================================================================

# Anthropic API key for Claude AI features
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini API key for image generation
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# =============================================================================
# Email Notifications (Optional)
# =============================================================================

# Mailgun API key and domain
# Get from: https://app.mailgun.com/
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# =============================================================================
# Frontend Build Configuration
# =============================================================================

# Backend API URL (used at frontend build time)
# For docker-compose: http://localhost:8000/api/v1
# For production: https://your-backend-domain.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1
